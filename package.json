{
  "name": "consta",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @consta/web dev",
    "dev:jobs": "pnpm --filter @consta/jobs dev",
    "build": "pnpm --filter @consta/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @consta/core db:generate",
    "db:migrate": "pnpm --filter @consta/core db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
