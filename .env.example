# Which adapters the composition roots use: "fake" (in-memory, no network) or "real".
CONSTA_ADAPTERS=fake

# Postgres with pgvector (Neon in production, Docker locally).
DATABASE_URL=postgres://consta:consta@localhost:5432/consta

# Cloudflare R2 (S3 API).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI providers (paid tiers, training off; see docs/adr/0005-paid-ai-tiers-only.md).
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
MISTRAL_API_KEY=

# Trigger.dev.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Email.
RESEND_API_KEY=
