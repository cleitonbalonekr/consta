# Which adapters the composition roots use: "fake" (fakes for the paid AI and email services) or "real".
# Both modes use Postgres, S3 and Trigger.dev: locally, the services of docker-compose.yml and `pnpm dev:jobs`.
CONSTA_ADAPTERS=fake

# Postgres with pgvector (Neon in production, Docker locally).
DATABASE_URL=postgres://consta:consta@localhost:5432/consta

# Object storage (S3 API): MinIO from docker-compose.yml locally, Cloudflare R2 in production (S3_REGION=auto).
# With CONSTA_ADAPTERS=fake, empty values fall back to these MinIO settings.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=consta
S3_ACCESS_KEY_ID=consta
S3_SECRET_ACCESS_KEY=consta-secret

# AI providers (paid tiers, training off; see docs/adr/0005-paid-ai-tiers-only.md).
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Trigger.dev, in both modes. Locally, the secret key of the project's "Development" environment (tr_dev_...).
# The project ref is in apps/jobs/trigger.config.ts.
TRIGGER_SECRET_KEY=
# "inline" runs ingestion inside the web server and needs no key. The E2E server sets it.
# CONSTA_JOBS=

# Sign-in (Better Auth). Any long random string, e.g. `openssl rand -base64 32`; `pnpm dev` works without one.
BETTER_AUTH_SECRET=
# The app's public URL; sign-in links point here.
BETTER_AUTH_URL=http://localhost:3000

# Email. With CONSTA_ADAPTERS=fake, sign-in links are printed to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Consta <noreply@consta.app>"

# Who may open the operator cost page (/operador/custos): comma-separated emails. Empty: no one.
OPERATOR_EMAILS=

# Stripe, for Pro (Checkout, Customer Portal and the webhook at /api/billing/webhook). Test keys locally (README).
# With CONSTA_ADAPTERS=fake and no secret key, a fake replaces Stripe. Setting the key uses Stripe, in either mode.
STRIPE_SECRET_KEY=
# The webhook signing secret: `stripe listen` prints one locally; the dashboard's endpoint has the production one.
STRIPE_WEBHOOK_SECRET=
# The monthly Price of Pro.
STRIPE_PRO_PRICE_ID=

# Deploy only: GitHub Actions settings for the "production" environment (.github/workflows/deploy.yml), never a .env file.
# Secrets: DATABASE_URL (Neon's direct, non-pooled connection, for migrations), TRIGGER_ACCESS_TOKEN, VERCEL_TOKEN.
# Variables: PRODUCTION_URL, VERCEL_ORG_ID, VERCEL_PROJECT_ID.
