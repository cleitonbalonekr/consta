{
  "name": "@consta/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ports": "./src/ports/index.ts",
    "./fakes": "./src/ports/fakes/index.ts",
    "./db": "./src/db/index.ts",
    "./testing": "./src/db/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
